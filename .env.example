NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace-with-your-publishable-key
# Legacy fallback for projects still using the old key format:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=legacy-anon-key
SUPABASE_SECRET_KEY=sb_secret_replace-with-your-secret-key
# Legacy fallback for projects still using the old key format:
# SUPABASE_SERVICE_ROLE_KEY=legacy-service-role-key
# Optional override; if omitted, the server derives a session key from SUPABASE_SECRET_KEY.
# BACKOFFICE_SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
